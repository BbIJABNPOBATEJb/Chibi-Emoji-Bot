# Токен от @BotFather
BOT_TOKEN=
# Telegram ID администраторов через запятую (узнать свой ID: команда /id в боте).
# Если пусто — при запуске в консоли появится одноразовая команда /claim <код> для назначения первого админа.
ADMIN_IDS=
# Лимиты обычного игрока (админы без лимитов; личные лимиты: /setlimit ID паки эмодзи). 0 = без лимита.
# Непустых паков (эмодзи и стикеры вместе; пустые не считаются)
MAX_PACKS_PER_USER=5
# Эмодзи и стикеров за последние 24 часа (создание и перерисовка; удаление квоту не возвращает)
DAILY_EMOJI_LIMIT=150
# Сколько пустых паков можно держать одновременно
MAX_EMPTY_PACKS=3
# Сколько скинов можно отправить за один раз (пользователь / админ)
MAX_BATCH_USER=50
MAX_BATCH_ADMIN=200
# Часовой пояс для дат в журнале
TIMEZONE=Europe/Moscow
# Папка для базы и скинов (относительно папки бота)
DATA_DIR=data
# Сколько процессов рисуют эмодзи параллельно: число или auto (по числу доступных ядер, не больше 4)
RENDER_WORKERS=auto
# Путь к ffmpeg, если он не в PATH (нужен для анимированных эмодзи)
FFMPEG_PATH=
# Что дописывать в конец названия каждого пака: auto = @юзернейм_бота, none = ничего, или свой текст
TITLE_SUFFIX=auto
# Лимит памяти контейнера (только docker compose). От него зависит, сколько процессов рисования
# реально запустится (около 300 МБ на каждый): 1g — 2 процесса, 2g — 4.
# BOT_MEMORY=1g
# MTU сети контейнера (только docker compose): уменьшите, если HTTPS из контейнера зависает
# DOCKER_MTU=1400
